{
  "manifest_version": 3,
  "name": "Numrow Video Seek Guard",
  "version": "1.1.0",
  "description": "Stops number-row keys from triggering seek shortcuts in video players, on any keyboard layout. Keys pressed with Shift are left alone.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "numrow-video-seek-guard@thomasgysemans.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}

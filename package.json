{
  "name": "numrow-video-seek-guard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "web-ext lint",
    "build": "npx web-ext build --overwrite-dest",
    "build:chromium": "node scripts/build-chromium.js"
  },
  "webExt": {
    "ignoreFiles": [
      "scripts",
      "tests",
      "package.json",
      "package-lock.json",
      "*.md"
    ]
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.7.0"
  }
}
